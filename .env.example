# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mooda
MYSQL_CHARSET=utf8mb4

# 微信开放平台配置
# 在微信开放平台（https://open.weixin.qq.com/）创建应用后获取
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_REDIRECT_URI=http://localhost:8003/api/v1/auth/wechat/callback

# 阿里云 LLM 配置
ALI_LLM_KEY=your_ali_llm_key
ALI_LLM_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# 聚合数据配置
JU_HE_MCP=your_juhe_api_key
